# Copy to .env.local and fill in. Leave both empty to run in local demo mode.
# These are PUBLIC browser values. Never put a service-role / secret key here.
# The NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY names created
# by the Vercel Supabase integration also work.

# Supabase → Project Settings → API Keys (or the "Connect" dialog)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...). The legacy anon key also works
# via VITE_SUPABASE_ANON_KEY, but the publishable key is recommended.
VITE_SUPABASE_PUBLISHABLE_KEY=
